# Template for apps/web/.env.acceptance — PLACEHOLDERS ONLY.
#
# Copy to .env.acceptance and fill in from the acceptance Supabase project's
# connection settings. The real file is gitignored and must never be committed.
#
# Guard rules enforced by scripts/lib/acceptance-db-target-v1.ts:
#   - TALEPO_ENVIRONMENT must be exactly "acceptance"
#   - both URLs must name the one allowed acceptance project ref
#   - the primary/production project is refused
#   - unknown hosts, localhost, other providers and unresolved placeholders fail closed
#   - both URLs must carry exactly "sslmode=verify-full" — "require" and "verify-ca"
#     encrypt without proving which server answered, and are refused
#   - the query may carry only sslmode, pgbouncer, connection_limit, pool_timeout,
#     connect_timeout and application_name; a repeated key or a "#" fragment fails closed
#
# Verify before use:  npx --yes tsx scripts/verify-acceptance-db-target-v1.ts

TALEPO_ENVIRONMENT=acceptance

# Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<ACCEPTANCE_PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=verify-full

# Session pooler (port 5432)
DIRECT_URL=postgresql://postgres.<ACCEPTANCE_PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=verify-full

# SHA-256 fingerprint of .acceptance/supabase-ca.crt, which you download by hand
# from THIS project's Supabase dashboard (Database Settings -> SSL Configuration).
# Not a secret, but the connection refuses to open unless it matches the file.
ACCEPTANCE_DB_CA_SHA256=<CA_SHA256_FINGERPRINT>

# Local-only auth values for the acceptance dev server; not secrets.
NEXTAUTH_URL=http://localhost:3187
NEXTAUTH_SECRET=<LOCAL_ACCEPTANCE_ONLY_SECRET>
