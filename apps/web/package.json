{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx --yes tsx scripts/ensure-dev-next-cache.mts && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "npx --yes tsx scripts/check-production-env.ts --production && next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "env:check": "npx --yes tsx scripts/check-production-env.ts",
    "env:check:prod": "npx --yes tsx scripts/check-production-env.ts --production",
    "verify:core": "npx --yes tsx scripts/verify-core.ts",
    "verify:phase4b": "npx --yes tsx scripts/verify-phase4b-soft-launch-v1.ts",
    "deploy:check": "npx --yes tsx scripts/check-production-env.ts --production && prisma generate && prisma migrate status",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
