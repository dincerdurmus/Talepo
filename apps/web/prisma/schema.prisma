generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PlatformRole {
  USER
  SUPPORT
  MODERATOR
  ANALYST
  ADMIN
  SUPER_ADMIN
}

enum AdminAuditAction {
  USER_UPDATED
  ROLE_CHANGED
  ACCOUNT_STATUS_CHANGED
  PLAN_CHANGED
  CREDIT_CHANGED
  SENSITIVE_DATA_VIEWED
  MFA_ENABLED
  MFA_DISABLED
  MODERATION_CASE_CREATED
  MODERATION_CASE_UPDATED
}

enum ModerationCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ModerationCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CompanyStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
  DELETED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum CompanyMemberStatus {
  INVITED
  ACTIVE
  REJECTED
  REMOVED
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  DECIMAL
  SINGLE_SELECT
  MULTI_SELECT
  CHECKBOX
  DATE
  FILE
}

enum CategorySuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

enum RequestStatus {
  DRAFT
  PUBLISHED
  RECEIVING_OFFERS
  OFFER_SELECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OfferStatus {
  DRAFT
  SUBMITTED
  VIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum Currency {
  TRY
  USD
  EUR
  GBP
}

enum PriceSignalType {
  EXTERNAL_LISTING
  TALEPO_REQUEST
  TALEPO_OFFER
  TALEPO_ACCEPTED_OFFER
  TALEPO_CONFIRMED_TRANSACTION
  EXTERNAL_SOLD
}

enum DealOutcomeStatus {
  PENDING
  COMPLETED
  CANCELLED
  PRICE_DISAGREEMENT
  PRODUCT_UNAVAILABLE
  NO_RESPONSE
  OTHER
}

enum TransactionConfirmationLevel {
  NONE
  BUYER_CONFIRMED
  SUPPLIER_CONFIRMED
  BOTH_CONFIRMED
  PAYMENT_VERIFIED
}

enum PriceConfidenceLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM
}

enum NotificationType {
  GENERAL
  REQUEST_PUBLISHED
  NEW_REQUEST_MATCH
  NEW_OFFER
  OFFER_VIEWED
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_NEGOTIATE
  NEW_MESSAGE
  COMPANY_INVITATION
  COMPANY_MEMBER_JOINED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum PlanTier {
  STANDARD
  PREMIUM
  PROFESSIONAL
  CORPORATE
}

/// Commercial context for SavedSearch / AlertRule — exactly one of USER|COMPANY.
enum ResourceOwnerType {
  USER
  COMPANY
}

enum OpportunityMatchSource {
  ALERT_RULE
  COMPANY_PROFILE
  INVENTORY
}

enum OpportunityMatchStatus {
  NEW
  VIEWED
  DISMISSED
  CONTACTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// scrypt hash: `salt:hash` (hex). Null = yalnızca OAuth.
  passwordHash String?

  /// Talepo üyelik numarası (ör. TLP-100001)
  membershipNumber String @unique

  phone                   String?
  country                 String       @default("Türkiye")
  city                    String?
  district                String?
  biography               String?      @db.Text
  status                  UserStatus   @default(ACTIVE)
  platformRole            PlatformRole @default(USER)
  lastLoginAt             DateTime?
  adminMfaEnabled         Boolean      @default(false)
  adminMfaSecretEncrypted String?      @db.Text

  planTier          PlanTier  @default(STANDARD)
  planExpiresAt     DateTime?
  bonusOfferCredits Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts Account[]
  sessions Session[]

  companyMemberships CompanyMember[]
  ownedCompanies     Company[]       @relation("CompanyCreator")

  categorySuggestions CategorySuggestion[]

  createdRequests   Request[]     @relation("RequestCreator")
  submittedOffers   Offer[]       @relation("OfferSubmitter")
  buyerDealOutcomes DealOutcome[] @relation("DealBuyer")

  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")

  notifications Notification[]

  /// Personal-owned Premium resources (workspace = USER)
  alertRules    AlertRule[]
  savedSearches SavedSearch[]

  /// Phase 4B — critical write idempotency keys
  idempotencyRecords      IdempotencyRecord[]
  adminAuditActions       AdminAuditLog[]     @relation("AdminAuditActor")
  adminAuditTargets       AdminAuditLog[]     @relation("AdminAuditTargetUser")
  assignedModerationCases ModerationCase[]    @relation("ModerationAssignee")
  reportedModerationCases ModerationCase[]    @relation("ModerationReporter")

  @@index([status])
  @@index([city, district])
  @@index([createdAt])
  @@index([membershipNumber])
  @@index([platformRole])
}

model AdminAuditLog {
  id            String           @id @default(cuid())
  actorId       String
  targetUserId  String?
  action        AdminAuditAction
  reason        String           @db.Text
  before        Json?
  after         Json?
  metadata      Json?
  ipHash        String?
  correlationId String?
  createdAt     DateTime         @default(now())

  actor      User  @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User? @relation("AdminAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model ModerationCase {
  id             String                 @id @default(cuid())
  subjectType    String
  subjectId      String
  category       String
  summary        String                 @db.Text
  priority       ModerationCasePriority @default(MEDIUM)
  status         ModerationCaseStatus   @default(OPEN)
  reporterId     String?
  assigneeId     String?
  resolutionNote String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  resolvedAt     DateTime?

  reporter User? @relation("ModerationReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee User? @relation("ModerationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([subjectType, subjectId])
  @@index([assigneeId, status])
}

model Account {
  id String @id @default(cuid())

  userId String
  type   String

  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id String @id @default(cuid())

  name String
  slug String @unique

  legalName   String?
  description String? @db.Text

  logoUrl    String? @db.Text
  coverUrl   String? @db.Text
  websiteUrl String?

  phone String?
  email String?

  taxNumber String?
  taxOffice String?

  country      String  @default("Türkiye")
  city         String?
  district     String?
  neighborhood String?
  address      String? @db.Text
  postalCode   String?

  status     CompanyStatus @default(DRAFT)
  isVerified Boolean       @default(false)

  planTier          PlanTier  @default(STANDARD)
  planExpiresAt     DateTime?
  bonusOfferCredits Int       @default(0)

  createdById String

  createdBy User @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members            CompanyMember[]
  categories         CompanyCategory[]
  inventoryItems     CompanyInventoryItem[]
  alertRules         AlertRule[]
  savedSearches      SavedSearch[]
  watchlistItems     OpportunityWatchlistItem[]
  opportunityMatches OpportunityMatch[]

  requests       Request[]
  offers         Offer[]
  requestMatches RequestMatch[]
  dealOutcomes   DealOutcome[]

  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageCompanySender")

  addonEntitlement CompanyAddonEntitlement?

  @@index([createdById])
  @@index([status])
  @@index([isVerified])
  @@index([city, district])
  @@index([createdAt])
}

/// Company-only commercial add-ons. Not a PlanTier and not a public membership SKU.
model CompanyAddonEntitlement {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  hiddenInventoryEnabled   Boolean   @default(false)
  hiddenInventoryExpiresAt DateTime?

  extraSeatsPurchased Int       @default(0)
  extraSeatsExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyInventoryItem {
  id String @id @default(cuid())

  companyId String

  name          String
  /// Legacy display field — kept for backward compat with existing rows
  title         String?
  categoryId    String?
  categoryLabel String?
  brand         String?
  model         String?
  quantity      Int      @default(1)
  unit          String   @default("adet")
  sku           String?
  price         Decimal? @db.Decimal(18, 2)
  city          String?
  attributes    Json?
  notes         String?  @db.Text
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  @@index([brand])
}

model AlertRule {
  id String @id @default(cuid())

  ownerType ResourceOwnerType @default(COMPANY)
  /// Set when ownerType = USER; null for COMPANY
  userId    String?
  /// Set when ownerType = COMPANY; null for USER
  companyId String?

  name     String
  isActive Boolean @default(true)

  categoryId String?
  city       String?
  district   String?
  minBudget  Decimal? @db.Decimal(18, 2)
  maxBudget  Decimal? @db.Decimal(18, 2)
  keywords   String?  @db.Text
  attributes Json?

  /// Phase 3A — optional typed canonical discovery filter (nullable legacy-safe).
  discoveryFilter Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([ownerType, userId])
  @@index([ownerType, companyId])
  @@index([companyId, isActive])
  @@index([categoryId])
  @@index([city])
}

model SavedSearch {
  id String @id @default(cuid())

  ownerType ResourceOwnerType @default(COMPANY)
  /// Set when ownerType = USER; null for COMPANY
  userId    String?
  /// Set when ownerType = COMPANY; null for USER
  companyId String?

  name     String
  filters  Json
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([ownerType, userId])
  @@index([ownerType, companyId])
  @@index([companyId, isActive])
}

model OpportunityWatchlistItem {
  id String @id @default(cuid())

  companyId String
  requestId String

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([companyId, requestId])
  @@index([companyId])
  @@index([requestId])
}

model RequestChange {
  id String @id @default(cuid())

  requestId String
  field     String
  oldValue  String? @db.Text
  newValue  String? @db.Text

  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([field])
  @@index([createdAt])
}

model OpportunityMatch {
  id String @id @default(cuid())

  companyId String
  requestId String

  source  OpportunityMatchSource
  score   Int                    @default(0)
  reasons Json?
  status  OpportunityMatchStatus @default(NEW)

  assignedToMemberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request          Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignedToMember CompanyMember? @relation(fields: [assignedToMemberId], references: [id], onDelete: SetNull)

  @@unique([companyId, requestId, source])
  @@index([companyId, status])
  @@index([requestId])
  @@index([score])
  @@index([assignedToMemberId])
}

model CompanyMember {
  id String @id @default(cuid())

  companyId String
  userId    String

  role   CompanyMemberRole   @default(MEMBER)
  status CompanyMemberStatus @default(INVITED)

  invitedAt DateTime  @default(now())
  joinedAt  DateTime?
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedOpportunities OpportunityMatch[]

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model Category {
  id String @id @default(cuid())

  name String
  slug String @unique

  icon String?

  description String? @db.Text

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyCategories CompanyCategory[]
  forms             RequestForm[]
  requests          Request[]
  suggestions       CategorySuggestion[]
  alertRules        AlertRule[]
  inventoryItems    CompanyInventoryItem[]
  priceObservations PriceObservation[]

  @@index([slug])
  @@index([isActive])
}

model CompanyCategory {
  id String @id @default(cuid())

  companyId  String
  categoryId String

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([companyId, categoryId])
}

model CategorySuggestion {
  id String @id @default(cuid())

  userId String

  categoryId String?

  name String

  description String? @db.Text

  status CategorySuggestionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
}

model RequestForm {
  id String @id @default(cuid())

  categoryId String

  name        String
  description String? @db.Text

  version Int @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  fields   FormField[]
  requests Request[]

  @@unique([categoryId, version])
  @@index([categoryId])
  @@index([isActive])
}

model FormField {
  id String @id @default(cuid())

  formId String

  key   String
  label String

  description String? @db.Text
  placeholder String?

  type FieldType

  isRequired Boolean @default(false)
  isActive   Boolean @default(true)

  sortOrder Int @default(0)

  minLength Int?
  maxLength Int?

  minValue Decimal? @db.Decimal(18, 4)
  maxValue Decimal? @db.Decimal(18, 4)

  options    Json?
  validation Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form RequestForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  values RequestFieldValue[]

  @@unique([formId, key])
  @@index([formId, sortOrder])
  @@index([isActive])
}

model RequestFieldValue {
  id String @id @default(cuid())

  requestId String
  fieldId   String

  textValue    String?   @db.Text
  numberValue  Decimal?  @db.Decimal(18, 4)
  booleanValue Boolean?
  dateValue    DateTime?
  jsonValue    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  field FormField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([requestId, fieldId])
  @@index([requestId])
  @@index([fieldId])
}

model Request {
  id String @id @default(cuid())

  createdById String
  companyId   String?
  categoryId  String
  formId      String?

  title       String
  description String @db.Text

  status RequestStatus @default(DRAFT)

  country  String  @default("Türkiye")
  city     String?
  district String?

  budgetMin Decimal? @db.Decimal(18, 2)
  budgetMax Decimal? @db.Decimal(18, 2)
  currency  Currency @default(TRY)

  aiScore                 Int?
  aiSummary               String? @db.Text
  professionalDescription String? @db.Text

  /// Phase 3A — publish-time discovery read model (taxonomy + constraints).
  /// Not a second request authority; null on legacy rows.
  discoveryProjection Json?

  /// Auto or manual cover image for the request card/detail.
  coverImageUrl String?

  viewCount  Int @default(0)
  offerCount Int @default(0)

  isUrgent      Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  /// Standart firmalar bu tarihten sonra talebi görebilir (Premium anında görür)
  visibleToSuppliersAt DateTime?

  /// Acil talepte teklif gelmezse alıcıya gönderilen “teklif gelmedi” nudge zamanı (idempotent)
  urgentOfferNudgeAt DateTime?

  deadlineAt  DateTime?
  publishedAt DateTime?
  expiresAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy User @relation("RequestCreator", fields: [createdById], references: [id], onDelete: Restrict)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  form RequestForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  fieldValues        RequestFieldValue[]
  offers             Offer[]
  matches            RequestMatch[]
  watchlistItems     OpportunityWatchlistItem[]
  changes            RequestChange[]
  opportunityMatches OpportunityMatch[]
  dealOutcomes       DealOutcome[]
  priceObservations  PriceObservation[]

  @@index([createdById])
  @@index([companyId])
  @@index([categoryId])
  @@index([formId])
  @@index([status])
  @@index([city, district])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([isFeatured, featuredUntil])
  @@index([isUrgent])
  @@index([visibleToSuppliersAt])
}

/// Talep yayınlandığında kategori/şehir ile eşleşen firmalar
model RequestMatch {
  id String @id @default(cuid())

  requestId String
  companyId String

  /// 100 kategori+şehir, 80 kategori, 50 yalnız şehir
  score Int @default(0)

  matchReason String?
  notifiedAt  DateTime?

  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([requestId, companyId])
  @@index([requestId])
  @@index([companyId])
  @@index([score])
  @@index([createdAt])
}

model Offer {
  id String @id @default(cuid())

  requestId     String
  submittedById String
  companyId     String?

  title       String?
  description String  @db.Text

  amount   Decimal  @db.Decimal(18, 2)
  currency Currency @default(TRY)

  deliveryDays Int?
  validUntil   DateTime?

  status OfferStatus @default(DRAFT)

  submittedAt DateTime?
  viewedAt    DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  withdrawnAt DateTime?
  expiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  submittedBy User @relation("OfferSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  conversation      Conversation?
  dealOutcome       DealOutcome?
  priceObservations PriceObservation[]

  /// Phase 4B — partial unique indexes (see migration):
  /// - (requestId, companyId) where companyId IS NOT NULL AND status active
  /// - (requestId, submittedById) where companyId IS NULL AND status active
  @@index([requestId])
  @@index([submittedById])
  @@index([companyId])
  @@index([status])
  @@index([submittedAt])
  @@index([createdAt])
}

model Conversation {
  id String @id @default(cuid())

  offerId String @unique

  title  String?
  status ConversationStatus @default(ACTIVE)

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  participants ConversationParticipant[]
  messages     Message[]
  dealOutcome  DealOutcome?

  @@index([status])
  @@index([lastMessageAt])
  @@index([createdAt])
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  userId         String?
  companyId      String?

  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  lastReadAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@unique([conversationId, companyId])
  @@index([conversationId])
  @@index([userId])
  @@index([companyId])
}

model Message {
  id String @id @default(cuid())

  conversationId  String
  senderUserId    String
  senderCompanyId String?

  type MessageType @default(TEXT)

  content  String? @db.Text
  fileUrl  String?
  fileName String?
  fileSize Int?
  mimeType String?

  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderUser User @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)

  senderCompany Company? @relation("MessageCompanySender", fields: [senderCompanyId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([senderCompanyId])
}

model Notification {
  id String @id @default(cuid())

  userId String

  type   NotificationType
  status NotificationStatus @default(UNREAD)

  title   String
  message String @db.Text

  actionUrl String?

  requestId String?
  offerId   String?
  companyId String?

  readAt     DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([type])
  @@index([requestId])
  @@index([offerId])
  @@index([companyId])
  @@index([createdAt])
}

/// Post-accept deal follow-up — accepted ≠ completed transaction
model DealOutcome {
  id String @id @default(cuid())

  requestId      String
  offerId        String  @unique
  conversationId String? @unique

  buyerUserId String
  companyId   String?

  status DealOutcomeStatus @default(PENDING)

  agreedPrice Decimal? @db.Decimal(18, 2)
  currency    Currency @default(TRY)

  completedAt DateTime?

  buyerConfirmedAt    DateTime?
  supplierConfirmedAt DateTime?

  confirmationLevel TransactionConfirmationLevel @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request      Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offer        Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  buyer        User          @relation("DealBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)

  priceObservations PriceObservation[]

  @@index([requestId])
  @@index([buyerUserId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

/// Raw price signal storage for Talepo Price Intelligence
model PriceObservation {
  id String @id @default(cuid())

  sourceType PriceSignalType
  sourceName String?

  requestId     String?
  offerId       String?
  dealOutcomeId String?

  categoryId String

  productFingerprint String?
  brand              String?
  model              String?
  condition          String?
  attributes         Json?

  price    Decimal  @db.Decimal(18, 2)
  currency Currency @default(TRY)

  location String?

  observedAt DateTime @default(now())

  confidence Decimal? @db.Decimal(5, 4)

  externalReferenceId String?
  metadata            Json?

  /// Idempotent upsert key, e.g. TALEPO_OFFER:{offerId}
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  request     Request?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  offer       Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  dealOutcome DealOutcome? @relation(fields: [dealOutcomeId], references: [id], onDelete: SetNull)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([sourceType])
  @@index([categoryId])
  @@index([productFingerprint])
  @@index([observedAt])
  @@index([currency])
  @@index([categoryId, productFingerprint, observedAt])
  @@index([sourceType, categoryId, observedAt])
}

/// Phase 4B — idempotency for critical marketplace writes (header Idempotency-Key).
model IdempotencyRecord {
  id         String   @id @default(cuid())
  userId     String
  scope      String
  key        String
  resourceId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([createdAt])
  @@index([userId, scope])
}

/// Phase 4C — billing subscription (provider-neutral). Entitlement plan synced from verified events.
enum BillingSubjectType {
  USER
  COMPANY
}

enum BillingSubscriptionStatus {
  INACTIVE
  PENDING
  ACTIVE
  PAST_DUE
  CANCEL_AT_PERIOD_END
  CANCELED
  EXPIRED
}

enum BillingEventProcessStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum CreditLedgerEntryType {
  PURCHASE
  BONUS
  ADMIN
  REFUND
  REVERSAL
}

model BillingSubscription {
  id String @id @default(cuid())

  subjectType BillingSubjectType
  subjectId   String

  planTier PlanTier
  status   BillingSubscriptionStatus @default(INACTIVE)

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  canceledAt             DateTime?
  pastDueAt              DateTime?
  providerVersion        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events BillingEvent[]

  @@unique([subjectType, subjectId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([provider])
}

model BillingEvent {
  id String @id @default(cuid())

  provider        String
  providerEventId String
  eventType       String
  subjectType     BillingSubjectType?
  subjectId       String?
  subscriptionId  String?
  status          BillingEventProcessStatus @default(RECEIVED)
  processedAt     DateTime?
  eventTimestamp  DateTime?
  providerVersion Int?
  /// Redacted / safe metadata only — never raw webhook body or secrets
  safeMetadata    Json?

  createdAt DateTime @default(now())

  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([subjectType, subjectId])
  @@index([eventType])
  @@index([createdAt])
}

model CreditLedgerEntry {
  id String @id @default(cuid())

  subjectType     BillingSubjectType
  subjectId       String
  entryType       CreditLedgerEntryType
  credits         Int
  packId          String?
  providerEventId String?               @unique
  note            String?

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
}
